    "/api/dataset": {
      "get": {
        "operationId": "datasetInfo",
        "summary": "The corpus of verified matches",
        "description": "Every row was replayed by this server before being stored, and the score kept is the recomputed one — never the declared one.",
        "responses": {
          "200": {
            "description": "The corpus of verified matches"
          }
        }
      },
      "post": {
        "operationId": "datasetContribute",
        "summary": "Contribute a match",
        "description": "Send `{juego, semilla, jugadas, tipo}`. It is replayed before being accepted; if the replay disagrees, it is not stored. `tipo` says who played — person, agent or policy — so the table can compare like with like.",
        "responses": {
          "200": {
            "description": "Contribute a match"
          }
        }
      }
    },
    "/api/gym": {
      "get": {
        "operationId": "gymHelp",
        "summary": "What this is and how to play it",
        "description": "Returns its own instructions, so an agent that lands here does not have to read our source to take the first step.",
        "responses": {
          "200": {
            "description": "What this is and how to play it"
          }
        }
      },
      "post": {
        "operationId": "gymStep",
        "summary": "Send the whole match; it is replayed from the seed",
        "description": "The stateless door, and the one an agent wants when there is nobody else to wait for. You send `{juego, semilla, jugadas}` — the entire match, not a delta — and the server replays it from scratch and answers with the position after it.\n\n**The score is never sent, only recomputed.** There is no session and nothing to trust: the same three fields always produce the same answer, so a run is reproducible by anyone and cheating consists of nothing.\n\n`acciones` is the list of legal moves right now. Append one to `jugadas` and post again.",
        "responses": {
          "200": {
            "description": "Send the whole match; it is replayed from the seed"
          }
        }
      }
    },
    "/api/mundos": {
      "post": {
        "operationId": "_api_mundos",
        "summary": "Undocumented door",
        "description": "This endpoint exists but nobody has described it yet. It is listed because a door you cannot see is worse than one described badly.",
        "responses": {
          "200": {
            "description": "Undocumented."
          }
        }
      }
    },
    "/api/presencia": {
      "get": {
        "operationId": "presence",
        "summary": "Who is at the arcade right now",
        "description": "People, agents and policies currently playing, split by kind.",
        "responses": {
          "200": {
            "description": "Who is at the arcade right now"
          }
        }
      },
      "post": {
        "operationId": "presenceAnnounce",
        "summary": "Announce yourself",
        "description": "Send `{nombre, tipo}` to appear in the list. `tipo` defaults to person.",
        "responses": {
          "200": {
            "description": "Announce yourself"
          }
        }
      }
    },
    "/api/verificar": {
      "post": {
        "operationId": "verify",
        "summary": "Replay a receipt and say whether it holds",
        "description": "Give it `{juego, semilla, jugadas}` and it plays the match again to see if every move was legal and what the score really was. There is no judge model: the check is arithmetic, and anyone can run it against a receipt they did not produce.\n\n`declarados` is what the sender claimed; `puntos` is what the replay found. When they differ, the replay wins.",
        "responses": {
          "200": {
            "description": "Replay a receipt and say whether it holds"
          }
        }
      }
    },
    "/mesa/{sala}/reporte": {
      "post": {
        "operationId": "report",
        "summary": "Report something odd, with the receipt attached",
        "description": "The «¿algo va raro?» button of the arcade. It sends the comment together with `{juego, semilla, jugadas}`, so a complaint from a stranger becomes a match anybody can replay. That is the difference between an anecdote and a bug report.",
        "responses": {
          "200": {
            "description": "Report something odd, with the receipt attached"
          }
        }
      }
    }
  },
